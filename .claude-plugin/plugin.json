{
  "name": "guard-rail",
  "version": "2.1.0",
  "description": "Keep personal data (LGPD/GDPR) out of the model. Redacts tool results with reversible pseudonyms, blocks prompts carrying PII, and logs every violation.",
  "author": {
    "name": "Willian Saez",
    "url": "https://github.com/williansaez"
  },
  "repository": "https://github.com/williansaez/guard-rail",
  "keywords": [
    "lgpd",
    "rgpd",
    "privacy",
    "pii",
    "redaction",
    "audit",
    "ollama",
    "hook"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/heartbeat.py\"",
            "timeout": 5,
            "statusMessage": "Armando guard-rail..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 15,
            "statusMessage": "Verificando dados pessoais..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*|Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/redact.py\"",
            "timeout": 20,
            "statusMessage": "Redigindo dados pessoais..."
          }
        ]
      }
    ]
  },
  "license": "MIT"
}
